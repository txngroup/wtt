# Copy to .env and fill in. Both settings are optional and read at build time (npm run build, npm run dev).

# The public address the site is served from, without a trailing slash. Used for canonical links, the social card
# image, robots.txt and sitemap.xml.
SITE_URL=https://wtt.example.org

# WalletConnect project id, for connecting EVM and Solana wallets on a phone. Create a free project at
# https://dashboard.reown.com and add your domain (and http://localhost:5173 for development) to its allowlist.
# Leave empty to offer browser wallets only.
VITE_WALLETCONNECT_PROJECT_ID=
