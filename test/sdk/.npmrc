# Supply-chain limits for every npm command run in this project.
# No package runs code at install time. None of ours need it: the only install scripts in the tree build
# Node-only WebSocket add-ons (bufferutil, utf-8-validate) and fsevents, which the browser build never uses.
ignore-scripts=true
# `npm install <pkg>` pins the exact version, as package.json already does by hand.
save-exact=true
# Resolve only versions published at least two weeks ago, so a hijacked release has time to be caught and pulled.
min-release-age=14
